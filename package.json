{
  "name": "numdraw",
  "version": "1.0.0",
  "description": "시설물 안전점검 넘버링 툴",
  "author": "NumDraw",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.numdraw.app",
    "productName": "NumDraw",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "lib/**/*",
      "electron/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "numdraw",
        "name": "NumDraw Project",
        "description": "NumDraw 넘버링 프로젝트",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NumDraw",
      "deleteAppDataOnUninstall": false
    }
  }
}
