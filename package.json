{
  "name": "quickspect",
  "version": "1.2.4",
  "description": "시설물 안전점검 조사보고서 작성 도구",
  "author": "Goldland",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "checkrelease": "node scripts/check-release-config.mjs",
    "prebuild": "node scripts/check-release-config.mjs",
    "build": "electron-builder --win --x64",
    "prebuild:admin": "node scripts/check-release-config.mjs",
    "build:admin": "electron-builder --win --x64 --config.extraMetadata.version=0.0.0 --config.appId=com.goldland.quickspect.admin --config.productName=\"Quickspect Admin\" --config.nsis.shortcutName=\"Quickspect Admin\" --config.directories.output=dist-admin"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.goldland.quickspect",
    "productName": "Quickspect",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "lib/**/*",
      "electron/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "qspec",
        "name": "Quickspect Project",
        "description": "퀵스도면 프로젝트",
        "role": "Editor"
      },
      {
        "ext": "numdraw",
        "name": "Quickspect Project (legacy)",
        "description": "퀵스도면 프로젝트 (구 확장자)",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quickspect",
      "deleteAppDataOnUninstall": false
    }
  }
}
